---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';

const ideas = (await getCollection('ideas')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Ideas — Matthew Batacan"
  description="Stuff I want to build next. Under construction — no promises on timing."
>
  <SiteHeader />

  <p class="ideas-intro">
    🚧 Under construction. This is where I keep a running list of things I want to
    build next — no timeline, no guarantee any of it ships.
  </p>

  <div class="ideas-list">
    {ideas.map(idea => (
      <div class="idea-item">
        <h2 class="idea-title">{idea.data.title}</h2>
        <p class="idea-date">
          {idea.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
        </p>
        <p class="idea-description">{idea.data.description}</p>
      </div>
    ))}
  </div>

  <Footer />
</BaseLayout>
