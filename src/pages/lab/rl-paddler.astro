---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="Race an RL Paddler — Matthew Batacan"
  description="Race a PPO-trained outrigger canoe steersman in 3D, or watch it duel a hand-coded baseline -- both running entirely in your browser."
  wide
>
  <SiteHeader />

  <div class="af-intro">
    <p>
      A reinforcement-learning agent trained to hold a heading in cross-wind and cross-current --
      the physics, training and evaluation are all in
      {' '}<a href="https://github.com/mbatacan/ama-flow" target="_blank" rel="noopener">ama-flow</a>,
      a separate repo. This page is a from-scratch TypeScript port of that physics core and a
      tiny re-implementation of the trained policy's neural net, checked against the Python
      original stroke by stroke. Nothing is sent anywhere; everything below runs in your browser.
    </p>
  </div>

  <div class="af-tabs" role="tablist">
    <button id="af-tab-watch" class="af-tab" type="button" aria-selected="true">Watch</button>
    <button id="af-tab-play" class="af-tab" type="button" aria-selected="false">Play</button>
  </div>

  <div class="af-game">
    <div class="af-canvas-col">
      <canvas id="af-canvas" class="af-canvas"></canvas>
      <div class="af-hud">
        <span id="af-hud-blue" class="af-hud-item af-hud-item--blue">blue: —</span>
        <span id="af-hud-red" class="af-hud-item af-hud-item--red">red: —</span>
        <span id="af-hud-stroke" class="af-hud-item">stroke 0/0</span>
        <button id="af-camera-toggle" class="af-camera-toggle" type="button">top-down view</button>
      </div>
      <div id="af-status" class="af-status">loading…</div>
    </div>

    <div class="af-controls-col">
      <div id="af-controls-watch" class="af-controls-panel">
        <p><strong class="af-blue">blue</strong> is the trained PPO model.</p>
        <p><strong class="af-red">red</strong> is the hand-coded baseline steersman.</p>
        <button id="af-restart-watch" class="af-button" type="button">restart</button>
      </div>

      <div id="af-controls-play" class="af-controls-panel" hidden>
        <p><strong class="af-blue">blue</strong> is you.</p>
        <p><strong class="af-red">red</strong> is the trained PPO model.</p>
        <ul class="af-keys">
          <li><kbd>&larr;</kbd> paddle port</li>
          <li><kbd>&rarr;</kbd> paddle starboard</li>
          <li><kbd>1</kbd> forward &middot; <kbd>2</kbd> draw &middot; <kbd>3</kbd> poke &middot; <kbd>4</kbd> rudder</li>
        </ul>
        <p class="af-hint">Your current selection fires automatically every stroke -- there's no separate "paddle" key.</p>
        <button id="af-start-play" class="af-button" type="button">restart</button>
      </div>
    </div>
  </div>

  <div id="af-results" class="af-results" hidden>
    <h3 id="af-results-title">Race over</h3>
    <p id="af-results-body"></p>
    <button id="af-results-close" class="af-button" type="button">close</button>
  </div>

  <Footer />
</BaseLayout>

<script>
  import { Duel, EPISODE_STROKES, FINISH_DISTANCE_M, policies, type SideId } from '../../scripts/ama-flow/game';
  import { decodeAction, lerpState } from '../../lib/ama-flow/physics';

  const SIDE_NAMES = ['port', 'starboard'];
  const STROKE_TYPE_NAMES = ['forward', 'draw', 'poke', 'rudder'];

  type Mode = 'watch' | 'play';

  const canvas = document.getElementById('af-canvas') as HTMLCanvasElement;
  const statusEl = document.getElementById('af-status')!;
  const hudBlueEl = document.getElementById('af-hud-blue')!;
  const hudRedEl = document.getElementById('af-hud-red')!;
  const hudStrokeEl = document.getElementById('af-hud-stroke')!;
  const tabWatch = document.getElementById('af-tab-watch')!;
  const tabPlay = document.getElementById('af-tab-play')!;
  const controlsWatch = document.getElementById('af-controls-watch')!;
  const controlsPlay = document.getElementById('af-controls-play')!;
  const restartWatchBtn = document.getElementById('af-restart-watch')!;
  const startPlayBtn = document.getElementById('af-start-play')!;
  const resultsEl = document.getElementById('af-results')!;
  const resultsTitleEl = document.getElementById('af-results-title')!;
  const resultsBodyEl = document.getElementById('af-results-body')!;
  const resultsCloseBtn = document.getElementById('af-results-close')!;
  const cameraToggleBtn = document.getElementById('af-camera-toggle')!;

  const STROKE_DURATION_S = 1.1; // matches ama-flow's oc6_stroke_config().duration_s
  const WATCH_SPEED = 2.5; // sim-seconds per real second; Watch has no input to time against
  const PLAY_SPEED = 1.3;

  let mode: Mode = 'watch';
  let duel = new Duel();
  let running = false;
  let clockS = 0;
  let lastTimeMs: number | null = null;
  const control = { side: 0, strokeType: 0 }; // PORT forward, until the player changes it

  function bluePlayerSide(): SideId {
    return 'player'; // blue is always the "player" slot: the model in Watch, you in Play
  }
  function redOpponentSide(): SideId {
    return 'opponent'; // red is always the "opponent" slot: the baseline in Watch, model in Play
  }

  function actionFor(side: SideId): number {
    if (mode === 'watch') {
      return side === bluePlayerSide()
        ? policies.model(duel.observation(side))
        : policies.baseline(duel.observation(side));
    }
    // Play: blue is the person's current control selection, red is the model.
    return side === bluePlayerSide()
      ? control.side * 4 + control.strokeType
      : policies.model(duel.observation(side));
  }

  function stepOneStroke(): void {
    (['player', 'opponent'] as SideId[]).forEach((side) => {
      if (!duel.isDone(side)) duel.step(side, actionFor(side));
    });
    hudStrokeEl.textContent = `stroke ${duel.history('player').actions.length}/${EPISODE_STROKES}`;
    if (duel.isDone('player') && duel.isDone('opponent')) finish();
  }

  function finish(): void {
    running = false;
    const blueLabel = mode === 'watch' ? 'model' : 'you';
    const redLabel = mode === 'watch' ? 'baseline' : 'model';
    const blueRms = duel.rmsHeadingErrorDeg(bluePlayerSide());
    const redRms = duel.rmsHeadingErrorDeg(redOpponentSide());
    const blueVmg = duel.distanceMadeGoodM(bluePlayerSide());
    const redVmg = duel.distanceMadeGoodM(redOpponentSide());
    const winner =
      blueRms < redRms && blueVmg > redVmg
        ? `blue (${blueLabel})`
        : redRms < blueRms && redVmg > blueVmg
          ? `red (${redLabel})`
          : 'no clean winner';
    resultsTitleEl.textContent = winner.startsWith('no') ? "It's close" : `${winner} wins`;
    resultsBodyEl.textContent =
      `blue (${blueLabel}): ${blueRms.toFixed(1)} deg RMS error, ${blueVmg.toFixed(0)} m made good. ` +
      `red (${redLabel}): ${redRms.toFixed(1)} deg RMS error, ${redVmg.toFixed(0)} m made good.`;
    resultsEl.hidden = false;
  }

  function restart(): void {
    duel = new Duel(duel.conditions, Math.floor(Math.random() * 1_000_000));
    clockS = 0;
    lastTimeMs = null;
    resultsEl.hidden = true;
    running = true;
  }

  function setMode(next: Mode): void {
    mode = next;
    tabWatch.setAttribute('aria-selected', String(next === 'watch'));
    tabPlay.setAttribute('aria-selected', String(next === 'play'));
    controlsWatch.hidden = next !== 'watch';
    controlsPlay.hidden = next !== 'play';
    hudBlueEl.textContent = next === 'watch' ? 'blue (model): —' : 'blue (you): —';
    hudRedEl.textContent = next === 'watch' ? 'red (baseline): —' : 'red (model): —';
    restart();
  }

  tabWatch.addEventListener('click', () => setMode('watch'));
  tabPlay.addEventListener('click', () => setMode('play'));
  restartWatchBtn.addEventListener('click', restart);
  startPlayBtn.addEventListener('click', restart);
  resultsCloseBtn.addEventListener('click', () => (resultsEl.hidden = true));

  window.addEventListener('keydown', (e) => {
    if (mode !== 'play') return;
    if (e.key === 'ArrowLeft') control.side = 0;
    else if (e.key === 'ArrowRight') control.side = 1;
    else if (e.key === '1') control.strokeType = 0;
    else if (e.key === '2') control.strokeType = 1;
    else if (e.key === '3') control.strokeType = 2;
    else if (e.key === '4') control.strokeType = 3;
  });

  import('../../scripts/ama-flow/scene').then(({ AmaFlowScene }) => {
    const scene = new AmaFlowScene(canvas, duel.conditions.wind_direction_rad, FINISH_DISTANCE_M);
    const resizeObserver = new ResizeObserver(() => scene.resize());
    resizeObserver.observe(canvas);

    let cameraMode: 'chase' | 'top' = 'chase';
    cameraToggleBtn.addEventListener('click', () => {
      cameraMode = cameraMode === 'chase' ? 'top' : 'chase';
      scene.setCameraMode(cameraMode);
      cameraToggleBtn.textContent = cameraMode === 'chase' ? 'top-down view' : 'chase view';
    });

    statusEl.textContent = 'ready';
    running = true;

    function frame(timeMs: number) {
      requestAnimationFrame(frame);
      if (lastTimeMs === null) lastTimeMs = timeMs;
      const dtS = Math.min((timeMs - lastTimeMs) / 1000, 0.25);
      lastTimeMs = timeMs;

      if (running) {
        const speed = mode === 'watch' ? WATCH_SPEED : PLAY_SPEED;
        clockS += dtS * speed;
        while (clockS >= STROKE_DURATION_S) {
          clockS -= STROKE_DURATION_S;
          if (!(duel.isDone('player') && duel.isDone('opponent'))) stepOneStroke();
        }
      }

      const elapsed = timeMs / 1000;
      // Render the transition from the stroke before last to the one just completed, timed
      // against clockS (elapsed since that step). This trades one stroke (~1s) of latency for
      // perfectly smooth motion, since the *next* state doesn't exist until the timer fires.
      const t = clockS / STROKE_DURATION_S;
      for (const side of ['player', 'opponent'] as SideId[]) {
        const states = duel.history(side).states;
        const i = Math.min(states.length - 1, states.length - (duel.isDone(side) ? 1 : 2));
        const a = states[Math.max(i, 0)];
        const b = states[Math.min(i + 1, states.length - 1)];
        const state = duel.isDone(side) ? states[states.length - 1] : lerpState(a, b, t);
        scene.setBoatState(side, state[0], state[1], state[2], elapsed);

        const lastAction = duel.history(side).actions.at(-1);
        if (lastAction !== undefined) {
          const { side: paddleSide, strokeType } = decodeAction(lastAction);
          scene.setStroke(side, paddleSide, strokeType, duel.isDone(side) ? 0 : t);
        }
      }
      scene.render(elapsed, bluePlayerSide());

      const blueLabel = mode === 'watch' ? 'model' : 'you';
      const redLabel = mode === 'watch' ? 'baseline' : 'model';
      const blueErr = duel.history('player').headingErrorDeg.at(-1) ?? 0;
      const redErr = duel.history('opponent').headingErrorDeg.at(-1) ?? 0;
      const blueAction = duel.history('player').actions.at(-1);
      const redAction = duel.history('opponent').actions.at(-1);
      const strokeText = (action: number | undefined) => {
        if (action === undefined) return '';
        const { side: s, strokeType: st } = decodeAction(action);
        return ` · ${SIDE_NAMES[s]} ${STROKE_TYPE_NAMES[st]}`;
      };
      hudBlueEl.textContent = `blue (${blueLabel}): ${blueErr.toFixed(1)} deg${strokeText(blueAction)}`;
      hudRedEl.textContent = `red (${redLabel}): ${redErr.toFixed(1)} deg${strokeText(redAction)}`;
    }
    requestAnimationFrame(frame);
  });
</script>
