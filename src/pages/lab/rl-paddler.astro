---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import { DEFAULT_POLICY_ID, POLICY_ENTRIES, type PolicyMeta } from '../../lib/ama-flow/policy';

const models = POLICY_ENTRIES.map((entry) => entry.meta);

/** MLflow stores params as Python reprs; turn enum reprs like `<Side.PORT: 0>` into `PORT`. */
const readable = (value: string) => value.replace(/<\w+\.(\w+): \d+>/g, '$1');

/** Params split for display: training hyperparameters vs the hull/ama/crew physics constants. */
function paramGroups(params: PolicyMeta['params']): [string, [string, string][]][] {
  const groups: Record<string, [string, string][]> = { training: [], hull: [], 'ama & crew': [] };
  for (const [key, value] of Object.entries(params).sort(([a], [b]) => a.localeCompare(b))) {
    if (key.startsWith('hull_')) groups.hull.push([key.slice(5), readable(value)]);
    else if (key.startsWith('ama_')) groups['ama & crew'].push([key, readable(value)]);
    else if (key.startsWith('crew_')) groups['ama & crew'].push([key, readable(value)]);
    else groups.training.push([key, readable(value)]);
  }
  return Object.entries(groups).filter(([, rows]) => rows.length > 0);
}

/** The eval grid as row objects keyed by column name. */
function gridRows(meta: PolicyMeta): Record<string, number | boolean>[] {
  const { columns, data } = meta.eval_grid;
  return data.map((row) => Object.fromEntries(columns.map((c, i) => [c, row[i]])));
}

const CHART_W = 240;
const CHART_H = 64;

/** SVG polyline points for one metric's curve, x spanning 0..total training steps so the
 * checkpoint's own step shows how far through training this entry is. */
function curvePoints(points: [number, number][], totalSteps: number): { line: string; min: number; max: number } {
  const values = points.map(([, v]) => v);
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min || 1;
  const line = points
    .map(([step, v]) => `${((step / totalSteps) * CHART_W).toFixed(1)},${(CHART_H - ((v - min) / span) * CHART_H).toFixed(1)}`)
    .join(' ');
  return { line, min, max };
}
---

<BaseLayout
  title="Race an RL Paddler — Matthew Batacan"
  description="Race an RL agent that steers an outrigger canoe, or watch it against a hand-coded baseline."
  wide
>
  <SiteHeader />

  <div class="af-intro">
    <p>
      A reinforcement-learning agent trained to hold a heading in cross-wind and cross-current while
      steering an outrigger canoe. Race it, or watch it against a hand-coded baseline. The physics and
      training are in{' '}<a href="https://github.com/mbatacan/ama-flow" target="_blank" rel="noopener">ama-flow</a>.
    </p>
    <p id="af-legend-watch" class="af-legend">
      <strong class="af-blue">blue</strong> is the selected trained model &middot;
      <strong class="af-red">red</strong> is the hand-coded baseline steersman.
    </p>
    <p id="af-legend-play" class="af-legend" hidden>
      <strong class="af-blue">blue</strong> is you &middot;
      <strong class="af-red">red</strong> is the selected trained model.
    </p>
  </div>

  <div class="af-tabs" role="tablist">
    <button id="af-tab-watch" class="af-tab" type="button" aria-selected="true">Watch</button>
    <button id="af-tab-play" class="af-tab" type="button" aria-selected="false">Play</button>
  </div>

  <label class="af-model-picker">
    model
    <select id="af-model-select" class="af-model-select">
      {models.map((m) => <option value={m.id} selected={m.id === DEFAULT_POLICY_ID}>{m.label}</option>)}
    </select>
  </label>

  <div class="af-game">
    <div class="af-canvas-col">
      <div class="af-progress-track">
        <div id="af-progress-blue" class="af-progress-marker af-progress-marker--blue"></div>
        <div id="af-progress-red" class="af-progress-marker af-progress-marker--red"></div>
        <div class="af-progress-finish"></div>
      </div>
      <div class="af-canvas-wrap">
        <canvas id="af-canvas" class="af-canvas"></canvas>
        <div class="af-compass">
          <div class="af-compass-rose">
            <div class="af-compass-rose-marker"></div>
            <div id="af-compass-target" class="af-compass-needle af-compass-needle--target"></div>
            <div id="af-compass-wind" class="af-compass-needle af-compass-needle--wind"></div>
            <div id="af-compass-current" class="af-compass-needle af-compass-needle--current"></div>
          </div>
          <div class="af-compass-legend">
            <span class="af-compass-legend-item af-compass-legend-item--target">steer</span>
            <span id="af-compass-wind-label" class="af-compass-legend-item af-compass-legend-item--wind">wind —</span>
            <span id="af-compass-current-label" class="af-compass-legend-item af-compass-legend-item--current">current —</span>
          </div>
        </div>
        <canvas id="af-minimap" class="af-minimap" width="120" height="120"></canvas>
        <div id="af-control-hud" class="af-control-hud" hidden>
          <div class="af-control-hud-row">
            <span id="af-control-key-side-0" class="af-control-key">port</span>
            <span id="af-control-key-side-1" class="af-control-key">starboard</span>
          </div>
          <div class="af-control-hud-row">
            <span id="af-control-key-stroke-0" class="af-control-key">forward</span>
            <span id="af-control-key-stroke-1" class="af-control-key">draw</span>
            <span id="af-control-key-stroke-2" class="af-control-key">poke</span>
            <span id="af-control-key-stroke-3" class="af-control-key">rudder</span>
          </div>
        </div>
        <div id="af-results" class="af-results" hidden>
          <h3 id="af-results-title">Race over</h3>
          <p id="af-results-margin" class="af-results-margin"></p>
          <table class="af-results-table">
            <thead>
              <tr>
                <th>canoe</th>
                <th>heading error</th>
                <th id="af-results-distance-header">distance</th>
                <th>avg speed</th>
              </tr>
            </thead>
            <tbody>
              <tr id="af-results-row-blue" class="af-results-row af-results-row--blue">
                <td id="af-results-blue-label"></td>
                <td id="af-results-blue-rms"></td>
                <td id="af-results-blue-distance"></td>
                <td id="af-results-blue-speed"></td>
              </tr>
              <tr id="af-results-row-red" class="af-results-row af-results-row--red">
                <td id="af-results-red-label"></td>
                <td id="af-results-red-rms"></td>
                <td id="af-results-red-distance"></td>
                <td id="af-results-red-speed"></td>
              </tr>
            </tbody>
          </table>
          <p id="af-results-time" class="af-results-time"></p>
          <button id="af-results-close" class="af-button" type="button">close</button>
        </div>
      </div>
      <div class="af-model-states">
        <span id="af-hud-blue" class="af-hud-item af-hud-item--blue">blue: —</span>
        <span id="af-hud-red" class="af-hud-item af-hud-item--red">red: —</span>
      </div>
      <div id="af-play-directions" class="af-play-directions" hidden>
        <ul class="af-keys">
          <li><kbd>&larr;</kbd> paddle port</li>
          <li><kbd>&rarr;</kbd> paddle starboard</li>
          <li><kbd>1</kbd> forward &middot; <kbd>2</kbd> draw &middot; <kbd>3</kbd> poke &middot; <kbd>4</kbd> rudder</li>
        </ul>
        <p class="af-hint">Your selection fires automatically every stroke, so there's no paddle key. It's highlighted at the bottom of the view.</p>
        <p class="af-hint">The green compass arrow points where to steer; wind and current show the same way. The small map in the corner shows the whole course.</p>
      </div>
      <div class="af-hud">
        <span id="af-hud-stroke" class="af-hud-item">stroke 0/0</span>
        <span id="af-hud-time" class="af-hud-item">0.0s</span>
        <button id="af-restart" class="af-camera-toggle" type="button">restart</button>
        <button id="af-speed-toggle" class="af-camera-toggle" type="button">1x speed</button>
        <button id="af-camera-toggle" class="af-camera-toggle" type="button">top-down view</button>
      </div>
      <div id="af-status" class="af-status">loading…</div>
    </div>
  </div>

  <section class="af-model-info">
    {models.map((m) => {
      const total = Number(m.params.total_timesteps);
      return (
        <div class="af-model-entry" data-model-id={m.id} hidden={m.id !== DEFAULT_POLICY_ID}>
          <h2 class="af-model-title">{m.label}</h2>
          <p class="af-model-note">{m.note}</p>
          <p class="af-chips">
            <span class="af-chip">run {m.run_id.slice(0, 8)}</span>
            <span class="af-chip">{m.step / 1000}k of {total / 1000}k steps</span>
            <span class="af-chip">seed {m.params.seed}</span>
            {m.registry && <span class="af-chip">registry v{m.registry.version}</span>}
          </p>
          <p class="af-chips">
            <span class="af-chip">ent_coef {m.params.ent_coef}</span>
            <span class="af-chip">lr {m.params.learning_rate}</span>
            <span class="af-chip">gamma {m.params.gamma}</span>
            <span class="af-chip">{m.params.n_envs} envs</span>
            <span class="af-chip">wind arm {m.params.hull_wind_cp_offset_m} m</span>
          </p>

          <details class="af-details">
            <summary>Settings</summary>
            {paramGroups(m.params).map(([group, rows]) => (
              <div class="af-param-group">
                <h4>{group}</h4>
                <dl class="af-params">
                  {rows.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
                </dl>
              </div>
            ))}
          </details>

          <details class="af-details">
            <summary>Results vs baseline <span class="af-summary-note">&middot; won {gridRows(m).filter((r) => r.agent_beats_baseline).length}/{m.eval_grid.data.length} cells</span></summary>
            <p class="af-hint">Cross-wind and cross-current, 10 episodes per cell. Lower heading error and higher speed are better; the baseline is the hand-coded steersman.</p>
            <table class="af-results-table">
              <thead>
                <tr><th>wind</th><th>current</th><th>heading error (model / baseline)</th><th>speed m/s (model / baseline)</th><th>model wins</th></tr>
              </thead>
              <tbody>
                {gridRows(m).map((r) => (
                  <tr class={r.agent_beats_baseline ? 'af-grid-win' : ''}>
                    <td>{r.wind_kt} kt</td>
                    <td>{r.current_kt} kt</td>
                    <td>{(r.agent_rms_heading_error_deg as number).toFixed(1)} / {(r.baseline_rms_heading_error_deg as number).toFixed(1)} deg</td>
                    <td>{(r.agent_mean_vmg_mps as number).toFixed(2)} / {(r.baseline_mean_vmg_mps as number).toFixed(2)}</td>
                    <td>{r.agent_beats_baseline ? 'yes' : 'no'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>

          <details class="af-details">
            <summary>Training curves</summary>
            <p class="af-hint">Logged every 20k steps during training; the line stops where this checkpoint was saved.</p>
            <div class="af-curves">
              {Object.entries(m.curve).map(([metric, points]) => {
                const { line, min, max } = curvePoints(points, total);
                return (
                  <figure class="af-curve">
                    <figcaption>{metric.replaceAll('_', ' ')} <span>{min.toFixed(2)} to {max.toFixed(2)}</span></figcaption>
                    <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} role="img" aria-label={`${metric} over training`}>
                      <polyline points={line} fill="none" stroke="#8b8bff" stroke-width="1.5" />
                    </svg>
                  </figure>
                );
              })}
            </div>
          </details>
        </div>
      );
    })}
  </section>

  <Footer />
</BaseLayout>

<script>
  import '../../scripts/ama-flow/page';
</script>
