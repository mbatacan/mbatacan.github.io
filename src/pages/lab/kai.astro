---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import {
  KAI_COMPETITIONS,
  KAI_ROUNDS,
  KAI_SUBMISSIONS,
  topPercent,
  type KaiCompetition,
  type KaiSubmission,
} from '../../data/kai-results';

interface Stage {
  name: string;
  role: string;
  model: string;
  llm: 'claude' | 'ollama' | 'none';
}

const STAGES: Stage[] = [
  { name: 'Scout', role: 'Works out the target, task type and metric (read from the Kaggle listing) and plans the approach.', model: 'Claude Opus', llm: 'claude' },
  { name: 'Researcher', role: 'Searches the web for general techniques and pitfalls. Never told the competition name.', model: 'Claude Sonnet', llm: 'claude' },
  { name: 'Analyst', role: 'Profiles the data and writes up insights.', model: 'Qwen 27B (local)', llm: 'ollama' },
  { name: 'Engineer', role: 'Writes feature code in a tool loop, running it against the real data.', model: 'Qwen 27B (local)', llm: 'ollama' },
  { name: 'Modeler', role: 'Trains a pool of models on shared folds and blends them on the competition metric.', model: 'Claude Sonnet picks the lead model; training is local', llm: 'claude' },
  { name: 'Critic', role: 'Decides whether to submit or iterate, and suggests next steps.', model: 'Claude Opus', llm: 'claude' },
  { name: 'Submitter', role: 'Writes the submission file. Plain code; it never calls an LLM.', model: 'none', llm: 'none' },
];

// Diagram layout: the stages snake across two rows inside the Pipeline box.
const STAGE_W = 112;
const STAGE_H = 44;
const stageX = (i: number) => 56 + (i % 4) * 124;
const stageY = (i: number) => (i < 4 ? 108 : 182);
const LLM_LABEL = { claude: 'Claude', ollama: 'Ollama · qwen', none: 'no LLM' };

// Best submission per competition: best public score, in the metric's own direction.
function best(comp: KaiCompetition): KaiSubmission {
  const rows = KAI_SUBMISSIONS.filter((s) => s.competition === comp.id);
  return rows.reduce((a, b) => ((comp.higherIsBetter ? b.publicScore > a.publicScore : b.publicScore < a.publicScore) ? b : a));
}
const bests = KAI_COMPETITIONS.map((comp) => ({ comp, row: best(comp) }));

const fmtScore = (n: number) => (n >= 100 ? n.toLocaleString('en-US', { maximumFractionDigits: 1 }) : String(n));
const fmtPct = (n: number) => `${n.toFixed(1)}%`;

// Progression chart: top-% per round, one line per competition (lower is better).
const CH = { w: 600, h: 300, left: 44, right: 150, top: 16, bottom: 44, max: 80 };
const plotW = CH.w - CH.left - CH.right;
const plotH = CH.h - CH.top - CH.bottom;
const cx = (i: number) => CH.left + (i / (KAI_ROUNDS.length - 1)) * plotW;
const cy = (pct: number) => CH.top + (pct / CH.max) * plotH;
const LINE_COLORS: Record<string, string> = { 'home-data': '#8b8bff', 'house-prices': '#e0b05a', spaceship: '#e05a5a' };
const series = KAI_COMPETITIONS.map((comp) => {
  const pts = KAI_ROUNDS.map((round) => {
    const row = KAI_SUBMISSIONS.find((s) => s.competition === comp.id && s.round === round)!;
    return topPercent(row);
  });
  return { comp, pts, color: LINE_COLORS[comp.id] };
});
---

<BaseLayout
  title="KAI — Matthew Batacan"
  description="A multi-agent system that works through Kaggle competitions end to end: architecture, models, feature engineering and results."
>
  <SiteHeader />

  <div class="post-content kai">
    <p>
      KAI is a multi-agent system that takes a Kaggle competition from a Slack command to a scored
      leaderboard submission. A run downloads the data, profiles it, engineers features, trains and
      blends models, decides whether the result is worth submitting, and reads back the score. Each
      agent posts a report to the Slack thread, and replies in that thread steer the next run.
    </p>

    <h2>Architecture</h2>
    <p>
      An orchestrator runs seven agents in sequence, passing files between them. It saves the run
      state to disk after every stage so a run can resume after a restart or a usage limit, and gives
      each stage a timeout. Every run is tracked in MLflow. The Critic decides whether to submit; KAI
      only submits when auto-submit is on.
    </p>

    <svg
      class="kai-diagram"
      viewBox="0 0 600 440"
      role="img"
      aria-label="KAI architecture: a Slack command starts the orchestrator, which downloads data from the Kaggle API and runs Scout, Researcher, Analyst, Engineer, Modeler, Critic and Submitter in order. The Submitter's file goes to Kaggle, which returns a score and rank to a results ledger. Every run is tracked in MLflow, and a Slack summary's thread replies steer the next run. Judgment stages use Claude and mechanical stages use a local Qwen model."
    >
      <defs>
        <marker id="kai-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="white" />
        </marker>
      </defs>

      <rect class="kai-container" x="20" y="92" width="560" height="148" rx="10" />
      <text class="kai-edge-label" x="32" y="106">Pipeline</text>

      <g>
        <rect class="kai-node" x="20" y="10" width="150" height="44" rx="6" />
        <text class="kai-node-label" x="95" y="30" text-anchor="middle">Slack</text>
        <text class="kai-node-tag" x="95" y="45" text-anchor="middle">/kai run competition</text>

        <rect class="kai-node" x="230" y="10" width="190" height="44" rx="6" />
        <text class="kai-node-label" x="325" y="30" text-anchor="middle">Orchestrator</text>
        <text class="kai-node-tag" x="325" y="45" text-anchor="middle">run state, timeouts</text>

        <rect class="kai-node" x="470" y="10" width="110" height="44" rx="6" />
        <text class="kai-node-label" x="525" y="30" text-anchor="middle">Kaggle API</text>
        <text class="kai-node-tag" x="525" y="45" text-anchor="middle">download data</text>
      </g>
      <line class="kai-edge" x1="170" y1="32" x2="229" y2="32" marker-end="url(#kai-arrow)" />
      <line class="kai-edge" x1="470" y1="32" x2="421" y2="32" marker-end="url(#kai-arrow)" />
      <line class="kai-edge" x1="325" y1="54" x2="325" y2="91" marker-end="url(#kai-arrow)" />

      {STAGES.map((s, i) => (
        <g>
          <rect class={`kai-node kai-node--${s.llm}`} x={stageX(i)} y={stageY(i)} width={STAGE_W} height={STAGE_H} rx="6" />
          <text class="kai-node-label" x={stageX(i) + STAGE_W / 2} y={stageY(i) + 19} text-anchor="middle">{s.name}</text>
          <text class="kai-node-tag" x={stageX(i) + STAGE_W / 2} y={stageY(i) + 35} text-anchor="middle">{LLM_LABEL[s.llm]}</text>
          {i % 4 !== 3 && i < STAGES.length - 1 && (
            <line class="kai-edge" x1={stageX(i) + STAGE_W} y1={stageY(i) + STAGE_H / 2} x2={stageX(i + 1) - 1} y2={stageY(i) + STAGE_H / 2} marker-end="url(#kai-arrow)" />
          )}
        </g>
      ))}
      <path class="kai-edge" d="M484,152 V167 H112 V181" fill="none" marker-end="url(#kai-arrow)" />
      <text class="kai-edge-label" x="424" y="190">hand-off files:</text>
      <text class="kai-edge-label" x="424" y="203">plan.json, features.pkl</text>
      <text class="kai-edge-label" x="424" y="216">model.pkl,</text>
      <text class="kai-edge-label" x="424" y="229">candidates.json</text>

      <g>
        <rect class="kai-node" x="20" y="278" width="170" height="44" rx="6" />
        <text class="kai-node-label" x="105" y="298" text-anchor="middle">Slack summary</text>
        <text class="kai-node-tag" x="105" y="313" text-anchor="middle">replies steer next run</text>

        <rect class="kai-node" x="205" y="278" width="130" height="44" rx="6" />
        <text class="kai-node-label" x="270" y="298" text-anchor="middle">MLflow</text>
        <text class="kai-node-tag" x="270" y="313" text-anchor="middle">tracks every run</text>

        <rect class="kai-node" x="350" y="278" width="120" height="44" rx="6" />
        <text class="kai-node-label" x="410" y="298" text-anchor="middle">Kaggle</text>
        <text class="kai-node-tag" x="410" y="313" text-anchor="middle">scores submission</text>

        <rect class="kai-node" x="330" y="346" width="160" height="44" rx="6" />
        <text class="kai-node-label" x="410" y="366" text-anchor="middle">Results ledger</text>
        <text class="kai-node-tag" x="410" y="381" text-anchor="middle">public score, rank</text>
      </g>
      <line class="kai-edge" x1="105" y1="240" x2="105" y2="277" marker-end="url(#kai-arrow)" />
      <line class="kai-edge kai-edge--dashed" x1="270" y1="240" x2="270" y2="277" marker-end="url(#kai-arrow)" />
      <line class="kai-edge" x1="380" y1="226" x2="380" y2="277" marker-end="url(#kai-arrow)" />
      <text class="kai-edge-label" x="388" y="262">submission.csv</text>
      <line class="kai-edge" x1="410" y1="322" x2="410" y2="345" marker-end="url(#kai-arrow)" />
      <path class="kai-edge" d="M20,300 H8 V32 H19" fill="none" marker-end="url(#kai-arrow)" />

      <text class="kai-edge-label" x="20" y="418">
        <tspan fill="#8b8bff">Claude</tspan> does the judgment: planning, research, model choice, submit-or-iterate.
      </text>
      <text class="kai-edge-label" x="20" y="434">
        <tspan fill="#e0b05a">Ollama · qwen</tspan> does the mechanical work and writes feature code.
      </text>
    </svg>

    <table class="kai-table">
      <thead>
        <tr><th>Stage</th><th>What it does</th><th>Model</th></tr>
      </thead>
      <tbody>
        {STAGES.map((s) => (
          <tr><td>{s.name}</td><td>{s.role}</td><td>{s.model}</td></tr>
        ))}
      </tbody>
    </table>
    <p class="kai-note">
      Claude runs through the local Claude CLI. The local Qwen model runs on Ollama.
    </p>

    <h2>Modeling</h2>
    <p>
      The Modeler trains a pool of LightGBM, XGBoost, CatBoost, RandomForest and a linear model on
      five shared folds, with a randomized search over 25 settings per family. It then hill-climbs blend
      weights on the competition's own metric. The blend is kept only if it beats the best single model
      by more than fold-to-fold noise, so most competitions end up with a single CatBoost model and
      only home-data keeps a blend. The metric shapes the pipeline: RMSLE trains on a log target, and
      accuracy gets a tuned decision threshold.
    </p>

    <h2>Feature engineering</h2>
    <p>
      A fixed toolkit does the generic work: splits composite columns, ordinal-encodes quality scales,
      adds log copies of skewed columns and drops id-like columns. The Engineer then adds domain
      features as named expressions. They must beat the toolkit baseline on a quick LightGBM check, and
      a run's feature set is promoted only if its cross-validation score beats the best on record, so
      later runs build on earlier ones. Nothing in the pipeline names a competition's columns.
    </p>
    <table class="kai-table">
      <thead>
        <tr><th>Competition</th><th>Features, baseline → best</th><th>What the LLM added</th></tr>
      </thead>
      <tbody>
        <tr><td>spaceship-titanic</td><td>16 → 43</td><td>about 10: spend totals and ratios, zero-spend flags, age interactions, cabin parts</td></tr>
        <tr><td>house-prices</td><td>917 → 277</td><td>about 22: total area, ratios, ages, bath totals, squared quality, has-X flags</td></tr>
        <tr><td>home-data</td><td>262 → 268</td><td>about 22, similar to house-prices</td></tr>
      </tbody>
    </table>
    <p class="kai-note">
      House-prices went down because the baseline used a large set of pairwise interactions that the
      later, leaner feature set outscored.
    </p>
    <p>
      Offline experiments that moved cross-validation by less than ±0.001: ExtraTrees, kNN, SVM and MLP
      ensemble members, a 13-model pool, seed averaging, PCA, count encodings, group aggregates and
      imputation variants.
    </p>

    <h2>Results</h2>
    <p>
      Best public-leaderboard result per competition, from five benchmark rounds on three
      Getting-Started competitions. The submissions themselves are on my{' '}<a
        href="https://www.kaggle.com/mcbatacan"
        target="_blank"
        rel="noopener">Kaggle profile</a>.
    </p>
    <table class="kai-table kai-table--num">
      <thead>
        <tr><th>Competition</th><th>Metric</th><th>Public score</th><th>Rank</th><th>Top</th><th>Model</th></tr>
      </thead>
      <tbody>
        {bests.map(({ comp, row }) => (
          <tr>
            <td>{comp.name}</td>
            <td>{comp.metric}</td>
            <td>{fmtScore(row.publicScore)}</td>
            <td>{row.rank} / {row.teams}</td>
            <td>{fmtPct(topPercent(row))}</td>
            <td>{row.model}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <svg
      class="kai-chart"
      viewBox={`0 0 ${CH.w} ${CH.h}`}
      role="img"
      aria-label={`Leaderboard position by benchmark round, lower is better. ${series.map((s) => `${s.comp.name}: ${s.pts.map(fmtPct).join(', ')}`).join('. ')}.`}
    >
      {[0, 10, 20, 40, 60, 80].map((v) => (
        <g>
          <line
            x1={CH.left}
            x2={CH.left + plotW}
            y1={cy(v)}
            y2={cy(v)}
            class={v === 10 ? 'kai-goal' : 'kai-grid'}
          />
          <text class="kai-axis" x={CH.left - 6} y={cy(v) + 4} text-anchor="end">{v}%</text>
        </g>
      ))}
      <text class="kai-axis" x={CH.left + plotW + 8} y={cy(10) + 4}>top-10% goal</text>
      {KAI_ROUNDS.map((round, i) => (
        <text class="kai-axis" x={cx(i)} y={CH.h - 18} text-anchor="middle">{round}</text>
      ))}
      {series.map((s) => (
        <g>
          <polyline
            fill="none"
            stroke={s.color}
            stroke-width="2"
            points={s.pts.map((p, i) => `${cx(i).toFixed(1)},${cy(p).toFixed(1)}`).join(' ')}
          />
          {s.pts.map((p, i) => <circle cx={cx(i)} cy={cy(p)} r="3" fill={s.color} />)}
          <text
            class="kai-line-label"
            fill={s.color}
            x={cx(KAI_ROUNDS.length - 1) + 10}
            y={cy(s.pts[s.pts.length - 1]) - (s.comp.id === 'spaceship' ? 0 : 8)}
          >{s.comp.id}</text>
        </g>
      ))}
    </svg>
    <p class="kai-note">Leaderboard position as a share of teams, lower is better.</p>

    <p>
      The top-10% goal is met on one of three: home-data. Spaceship-titanic is stuck around the top
      37%, and its cross-validation score runs about 0.015–0.018 above its public score. These are
      public-leaderboard numbers only, and the first home-data baseline and the candidate-pool round
      were tuned on RMSLE instead of the competition's MAE.
    </p>

    <h2>What's next</h2>
    <p>
      Running the Playground competitions, a Critic that iterates on its own without waiting for a
      reply, and non-tabular tasks (text, vision, time series).
    </p>
  </div>

  <Footer />
</BaseLayout>
