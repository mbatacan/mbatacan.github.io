---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import { LAB_PROJECTS } from '../../data/lab-projects';

const completed = LAB_PROJECTS.filter(p => p.status === 'completed');
const inProgress = LAB_PROJECTS.filter(p => p.status === 'in-progress');
---

<BaseLayout
  title="Lab — Matthew Batacan"
  description="Small, interactive machine-learning demos that run entirely in your browser."
>
  <SiteHeader />

  <section>
    <h2 class="lab-section-title">Completed</h2>
    <div class="lab-gallery">
      {completed.map(project => (
        <a class="lab-card" href={project.href}>
          <h3 class="lab-card-title">{project.title}</h3>
          <p class="lab-card-description">{project.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="lab-section-title">In Progress</h2>
    <div class="lab-gallery">
      {inProgress.map(project => (
        <div class="lab-card lab-card--in-progress">
          <h3 class="lab-card-title">{project.title}</h3>
          <p class="lab-card-description">{project.description}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</BaseLayout>
