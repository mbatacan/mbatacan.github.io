---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { fetchRecentActivity } from '../lib/github';

const repos = await fetchRecentActivity();
---

<BaseLayout
  title="Log — Matthew Batacan"
  description="What I've most recently been committing to, pulled live from GitHub."
>
  <SiteHeader />

  <div class="log-repos">
    {repos.map(repo => (
      <div class="log-repo">
        <div class="log-repo-header">
          <a class="log-repo-name" href={repo.url} target="_blank" rel="noopener">{repo.name}</a>
          <span class="log-repo-date">
            {new Date(repo.pushedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </span>
        </div>
        {repo.description && <p class="log-repo-description">{repo.description}</p>}
        <div class="log-commits">
          {repo.commits.map(message => (
            <div class="log-commit">{message}</div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <Footer />
</BaseLayout>
