---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Matthew Batacan"
  description="Data scientist from Hawaii, BU grad, working on sensor data insights and prognostics at Boeing."
>
  <ProfileHeader />
  <SiteNav />

  <div class="about-bio">
    <p>I grew up in Honolulu, Hawaii.</p>
  </div>

  <div class="home-schools">
    <div class="home-school">
      <img src="/assets/icons/iolani-logo.png" alt="" />
      <span>Iolani School</span>
    </div>
    <div class="home-school">
      <img src="/assets/icons/bu-logo.jpeg" alt="" />
      <span>Boston University, Data Science</span>
    </div>
  </div>

  <div class="about-bio">
    <p>
      I'm interested in data science, machine learning, time series analysis, reinforcement
      learning, deep learning, and MLOps.
    </p>
  </div>

  <details class="home-work">
    <summary>Work experience</summary>
    <ul class="home-jobs">
      <li class="no-logo">
        <span><strong>Boeing</strong>, currently. Sensor data insights, alerting, and prognostics.</span>
      </li>
      <li>
        <img src="/assets/icons/bu-spark.png" alt="" />
        <span>
          <strong><a href="https://www.bu.edu/spark/" target="_blank" rel="noopener">BU Spark!</a></strong>,
          Technical Project Manager. Led student data science teams embedded with journalism
          partners for the Justice Media Co-lab.
        </span>
      </li>
      <li>
        <img src="/assets/icons/ibm-reebus.png" alt="" />
        <span><strong>IBM</strong>, data science intern on the ibm.com search engine.</span>
      </li>
      <li class="no-logo"><span>Also a healthcare startup and a data science tutor.</span></li>
    </ul>
  </details>

  <Footer />
</BaseLayout>
