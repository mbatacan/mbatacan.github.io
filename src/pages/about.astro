---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="About Me — Matthew Batacan"
  description="Data scientist from Hawaii, BU grad, former BU Spark TPM and IBM intern."
>
  <ProfileHeader />

  <div class="about-bio">
    <p>
      I grew up in Honolulu, Hawaii and attended Iolani School. I graduated from
      Boston University with a degree in Data Science.
    </p>
    <p>
      During undergrad I served as a Technical Project Manager at
      <a href="https://www.bu.edu/spark/" target="_blank" rel="noopener">BU Spark!</a>,
      BU's applied research lab, where I led student data science teams embedded with
      journalism partners for the Justice Media Co-lab.
    </p>
    <p>
      I interned at IBM as a data scientist working on the ibm.com search engine, and
      have also worked with a healthcare startup and as a data science tutor.
    </p>
  </div>

  <div class="photo-grid">
    <img src="/assets/icons/iolani-logo.png" alt="Iolani School" />
    <img src="/assets/icons/bu-logo.jpeg" alt="Boston University" />
    <img src="/assets/icons/bu-spark.png" alt="BU Spark!" />
    <img src="/assets/icons/ibm-reebus.png" alt="IBM" />
  </div>

  <Footer links={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }]} />
</BaseLayout>
