---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Blog — Matthew Batacan" description="Writing about data science, machine learning, and projects.">
  <SiteHeader />

  <div class="blog-posts">
    {posts.map(post => (
      <div class="blog-link">
        <a class="blog-link-title" href={`/blog/${post.id}`}>{post.data.title}</a>
        <p class="blog-link-date">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
        </p>
        <p class="blog-link-description">{post.data.description}</p>
      </div>
    ))}
  </div>

  <Footer />
</BaseLayout>
