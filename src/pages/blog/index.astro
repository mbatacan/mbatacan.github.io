---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileHeader from '../../components/ProfileHeader.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Blog — Matthew Batacan" description="Writing about data science, machine learning, and projects.">
  <ProfileHeader />

  <div class="blog-posts">
    {posts.map(post => (
      <div class="blog-link">
        <a class="nav-link" href={`/blog/${post.slug}`}>{post.data.title}</a>
      </div>
    ))}
  </div>

  <Footer links={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about' }]} />
</BaseLayout>
